string ModelFileName(const int file)
{
  switch(file)
  {
    case 0: return "run_manifest.tsv";
    case 1: return "macro_windows.tsv";
    case 2: return "signal_events.tsv";
    case 3: return "feature_snapshots.tsv";
    case 4: return "entry_attempts.tsv";
    case 5: return "trials.tsv";
    case 6: return "execution_checks.tsv";
    case 7: return "outcomes.tsv";
    case 8: return "run_summary.tsv";
    case 9: return "pivot_origins.tsv";
    case 10: return "candle_signals.tsv";
    case 11: return "candle_attempts.tsv";
  }
  return "";
}

