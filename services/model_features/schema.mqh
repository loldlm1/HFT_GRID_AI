        case 13: return "|ACCEPTED|REJECTED|ELIGIBLE|NOT_TRIGGERED|CAPACITY_REJECTED|INELIGIBLE_GEOMETRY|INELIGIBLE_DISTANCE|INELIGIBLE_MONEY|INELIGIBLE_MONEY_PLAN|";
        case 47: return "|SECOND|MILLISECOND|";
        case 50: return "|SECOND|MILLISECOND|";
        case 53: return "|SECOND|MILLISECOND|";
      }
      break;
    case 6:
      switch(column)
      {
        case 75: return "|SECOND|MILLISECOND|";
      }
      break;
    case 7:
      switch(column)
      {
        case 3: return "|BROKER|VIRTUAL|PARITY|";
        case 5: return "|TP_FIRST|SL_FIRST|TIME_EXIT|OTHER_CLOSE|CENSORED_RUN_END|REJECTED|NOT_TRIGGERED|CAPACITY_REJECTED|INELIGIBLE_GEOMETRY|INELIGIBLE_DISTANCE|INELIGIBLE_MONEY|INELIGIBLE_MONEY_PLAN|";
        case 62: return "|SECOND|MILLISECOND|";
        case 65: return "|SECOND|MILLISECOND|";
        case 68: return "|SECOND|MILLISECOND|";
        case 71: return "|SECOND|MILLISECOND|";
        case 74: return "|SECOND|MILLISECOND|";
      }
      break;
    case 8:
      switch(column)
      {
      }
      break;
    case 9:
      switch(column)
      {
        case 3: return "|S3|S2|S1|PP|R1|R2|R3|";
      }
      break;
    case 10:
      switch(column)
      {
        case 2: return "|HARAMI|ENGULFING|";
        case 3: return "|BULLISH|BEARISH|";
      }
      break;
    case 11:
      switch(column)
      {
        case 2: return "|HARAMI|ENGULFING|";
        case 3: return "|ALIGNED|OPPOSED|";
        case 17: return "|SECOND|MILLISECOND|";
      }
      break;
  }
  return "";
}

bool ModelEngineFile(const int file, const string engine)
{
  if(engine == "PIVOT_MACRO_V1")
    return file == 0 || file == 1 || file == 2 || file == 3 || file == 4 || file == 5 || file == 6 || file == 7 || file == 8 || file == 9;
  if(engine == "CANDLE_PATTERN_ATR_V2")
    return file == 0 || file == 1 || file == 2 || file == 3 || file == 4 || file == 5 || file == 6 || file == 7 || file == 8 || file == 10 || file == 11;
  return false;
}

#endif
